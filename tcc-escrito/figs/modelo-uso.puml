@startuml
skinparam backgroundColor #ffffff
skinparam shadowing false
skinparam actorStyle awesome
left to right direction

actor "Usuário autenticado" as User
rectangle "Dashboard Financeiro" {
  usecase "Gerenciar\ncontas bancárias" as UC1
  usecase "Organizar\ncategorias" as UC2
  usecase "Registrar\ntransações" as UC3
  usecase "Definir metas\n e alocações" as UC4
  usecase "Visualizar dashboards\n e módulo educativo" as UC5
  usecase "Receber notificações\npor e-mail" as UC6
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6

UC3 .> UC2 : <<inclui>>
UC4 .> UC6 : <<estende>>

note right of UC5
  Inclui os modos Quadros e Analytics,
  consumindo as APIs consolidadas
  descritas no Capítulo 3.
end note

note bottom of UC6
  Acontece via eventos Kafka + Resend
  quando metas mudam de status ou
  transações relevantes são registradas.
end note

@enduml
