<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">

    <changeSet id="001-create-bank-accounts" author="codex">
        <createTable tableName="bank_accounts">
            <column name="id" type="uniqueidentifier">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="uniqueidentifier">
                <constraints nullable="false"/>
            </column>
            <column name="institution_name" type="nvarchar(120)">
                <constraints nullable="false"/>
            </column>
            <column name="branch_number" type="nvarchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="account_number" type="nvarchar(30)">
                <constraints nullable="false"/>
            </column>
            <column name="account_digit" type="nvarchar(5)"/>
            <column name="account_type" type="nvarchar(30)">
                <constraints nullable="false"/>
            </column>
            <column name="nickname" type="nvarchar(60)"/>
            <column name="current_balance" type="decimal(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="datetime2">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="datetime2">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="bank_accounts"
                columnNames="user_id, institution_name, account_number, account_digit, branch_number"
                constraintName="uk_bank_accounts_user_account"/>

        <createIndex indexName="idx_bank_accounts_user" tableName="bank_accounts">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="002-create-transactions" author="codex">
        <createTable tableName="transactions">
            <column name="id" type="uniqueidentifier">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="bank_account_id" type="uniqueidentifier">
                <constraints nullable="false"/>
            </column>
            <column name="transaction_type" type="nvarchar(30)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="decimal(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="transaction_date" type="date">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="nvarchar(200)">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="nvarchar(80)"/>
            <column name="notes" type="nvarchar(255)"/>
            <column name="created_at" type="datetime2">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="datetime2">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="transactions"
                baseColumnNames="bank_account_id"
                referencedTableName="bank_accounts"
                referencedColumnNames="id"
                constraintName="fk_transactions_bank_account"
                onDelete="CASCADE"/>

        <createIndex indexName="idx_transactions_bank_account" tableName="transactions">
            <column name="bank_account_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
